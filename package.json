{
  "name": "marker-and-mayhem",
  "version": "1.0.0",
  "description": "A browser Pictionary host. Both teams draw the same word at once, and every phone stays in sync offline.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run.mjs",
    "test:dom": "node build.mjs && node test/dom.mjs",
    "test:e2e": "node build.mjs && node test/e2e-multidevice.mjs",
    "test:creative": "node build.mjs && node test/e2e-creative-match.mjs",
    "test:all": "npm run test && npm run test:dom && node test/e2e-multidevice.mjs && node test/e2e-creative-match.mjs && node test/e2e-twoplayer-fixes.mjs && node test/e2e-user-requests.mjs",
    "lint": "eslint src/ test/ build.mjs",
    "format": "prettier --write src/ test/ build.mjs *.json",
    "start": "node build.mjs && python3 -m http.server 8080"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.0.0"
  },
  "keywords": [
    "pictionary",
    "party-game",
    "offline-first",
    "pwa",
    "qr",
    "zero-dependency"
  ]
}
